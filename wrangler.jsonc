// Cloudflare Workers static assets. The repository root is the site; there is
// no build step and no Worker script. Files listed in .assetsignore are not
// uploaded.
{
  "name": "website",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": true
}
